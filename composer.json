{
    "name": "dzentota/template-variable",
    "description": "A secure template variable library that provides context-aware escaping for PHP templates using TypedValue objects",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Tatulchenkov",
            "email": "webtota@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "dzentota/typedvalue": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Dzentota\\TemplateVariable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dzentota\\TemplateVariable\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
} 
